# AI Council — Environment Configuration Example
# Salin file ini menjadi .env jika ingin menambahkan API key atau mengubah port.
# PENTING: Aplikasi dapat berjalan 100% menggunakan Mode A (Manual Bridge) tanpa mengisi API key apa pun.

APP_NAME="AI Council"
APP_VERSION="1.0.0"
DEBUG=false
HOST="127.0.0.1"
PORT=8000

# SQLite Database (Disimpan di folder data/ yang terpisah dari source code)
DATABASE_URL="sqlite:///data/ai_council.db"

# Batas Upload & Debat
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_DEBATE_ROUNDS=5
DEFAULT_DEBATE_ROUNDS=2
API_TIMEOUT_SECONDS=60.0

# Kunci API Opsional (Mode B: Official API)
# Kosongkan jika hanya menggunakan antarmuka web / Manual Bridge
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
