# AI Council — Environment Configuration Example
# Salin file ini menjadi .env jika ingin menambahkan API key atau mengubah port.
# PENTING: Aplikasi dapat berjalan 100% menggunakan Mode A (Manual Bridge) tanpa mengisi API key apa pun.

APP_NAME="AI Council"
APP_VERSION="1.0.0"
DEBUG=false
HOST="127.0.0.1"
PORT=8000

# SQLite Database (Disimpan di folder data/ yang terpisah dari source code)
DATABASE_URL="sqlite:///data/ai_council.db"

# Batas Upload & Debat
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_DEBATE_ROUNDS=3
DEFAULT_DEBATE_ROUNDS=2
API_TIMEOUT_SECONDS=60.0

# Kunci API Opsional (Mode B: Official API & Free Multi-Provider)
# Kosongkan jika hanya menggunakan antarmuka web / Manual Bridge
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Multi-Provider Gratis (OpenRouter, DashScope, DeepSeek, Ollama)
OPENROUTER_API_KEY=""
DASHSCOPE_API_KEY=""
DEEPSEEK_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Keamanan Biaya: Zero-Cost Mode (Default: true)
# Memastikan sistem menolak model berbayar dan hanya mengeksekusi model berbiaya Rp 0
AI_COUNCIL_ZERO_COST_MODE=true
